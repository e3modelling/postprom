<<setup, echo=FALSE, warning=FALSE, message=FALSE>>=
library(ggplot2)
plot_list <- readRDS(plot_rds_path)
@

\newpage

<<validation, echo=FALSE, results='asis', warning=FALSE, message=FALSE>>=
if (!is.null(validation_result)) {
  format_number <- function(x) {
    ifelse(is.na(x), "", formatC(x, digits = 4, format = "g"))
  }

  cat("\\section{Indicator Validation}\n\n")
  cat(
    "The checks in this section use indicators already calculated by ",
    "\\texttt{reportIndicators()}; indicator formulas are not recalculated ",
    "during validation.\n\n",
    sep = ""
  )

  summary_table <- validation_result$summary
  names(summary_table) <- c("Scenario", "Pass", "Warn", "Fail", "Skip")
  cat("\\subsection{Summary}\n\n")
  cat(
    knitr::kable(
      summary_table,
      format = "latex",
      booktabs = TRUE,
      row.names = FALSE,
      escape = TRUE
    ),
    sep = "\n"
  )
  cat("\n\n")

  benchmark_table <- validation_result$findings[
    validation_result$findings$check_type %in% c("level", "cagr") &
      validation_result$findings$status != "skip",
    ,
    drop = FALSE
  ]
  if (nrow(benchmark_table)) {
    benchmark_table$period <- ifelse(
      benchmark_table$start_year == benchmark_table$end_year,
      benchmark_table$end_year,
      paste0(benchmark_table$start_year, "--", benchmark_table$end_year)
    )
    benchmark_table$observed <- format_number(benchmark_table$observed)
    benchmark_table$reference <- format_number(benchmark_table$reference)
    benchmark_table$deviation <- ifelse(
      is.na(benchmark_table$deviation),
      "",
      paste0(
        formatC(
          100 * benchmark_table$deviation,
          digits = 1,
          format = "f"
        ),
        "%"
      )
    )
    benchmark_table$status <- toupper(benchmark_table$status)
    benchmark_table <- benchmark_table[, c(
      "indicator", "region", "period",
      "observed", "reference", "unit", "deviation", "status", "source"
    )]
    names(benchmark_table) <- c(
      "Indicator", "Region", "Period", "Observed", "Reference", "Unit",
      "Deviation", "Status", "Source"
    )
    cat("\\subsection{Evaluated benchmarks}\n\n")
    cat("\\scriptsize\n")
    cat(
      knitr::kable(
        benchmark_table,
        format = "latex",
        booktabs = TRUE,
        longtable = TRUE,
        row.names = FALSE,
        escape = TRUE
      ),
      sep = "\n"
    )
    cat("\n\\normalsize\n\n")
  }

  exception_table <- validation_result$findings[
    validation_result$findings$status != "pass",
    ,
    drop = FALSE
  ]
  cat("\\subsection{Exceptions}\n\n")
  if (!nrow(exception_table)) {
    cat("No validation exceptions were found.\n\n")
  } else {
    exception_table$period <- ifelse(
      is.na(exception_table$start_year),
      "",
      ifelse(
        exception_table$start_year == exception_table$end_year,
        exception_table$end_year,
        paste0(exception_table$start_year, "--", exception_table$end_year)
      )
    )
    exception_table$status <- toupper(exception_table$status)
    exception_table <- exception_table[, c(
      "indicator", "region", "period", "status", "message", "source"
    )]
    names(exception_table) <- c(
      "Indicator", "Region", "Period", "Status", "Message", "Source"
    )
    cat("\\scriptsize\n")
    cat(
      knitr::kable(
        exception_table,
        format = "latex",
        booktabs = TRUE,
        longtable = TRUE,
        row.names = FALSE,
        escape = TRUE
      ),
      sep = "\n"
    )
    cat("\n\\normalsize\n\n")
  }
  cat("\\newpage\n")
}
@

<<generate_plots, echo=FALSE, results='asis', fig.width=10, fig.height=12, fig.pos='H'>>=
### Function to extract regions from a single plot (facet strips)
get_regions_from_plot <- function(p) {
  facet_var <- names(p$facet$params$facets)

  if (!is.null(facet_var) && facet_var %in% names(p$data)) {
    regions <- unique(p$data[[facet_var]])
  } else {
    regions <- NULL
  }

  regions[!is.na(regions)]
}

### Function to reorder regions with "World" first
reorder_regions <- function(regions) {
  if ("World" %in% regions) {
    c("World", setdiff(regions, "World"))
  } else {
    regions
  }
}

### MAIN LOOP
for (section_name in names(plot_list)) {

  plots <- plot_list[[section_name]]

  cat("\\newpage\n")

  ### ---- SECTION TITLE (creates its own bookmark automatically) ----
  cat(sprintf("\\section{%s}\n\n", section_name))

  ### ---- LOOP OVER PLOTS ----
  for (i in seq_along(plots)) {

    p <- plots[[i]]

    # Extract regions
    regions <- get_regions_from_plot(p)
    regions <- reorder_regions(regions)
    region_subtitle <- paste(regions, collapse = ", ")

    ### ---- PLOT-LEVEL BOOKMARK ONLY ----
    cat(sprintf(
      "\\pdfbookmark[3]{Regions: %s}{bookmark-%s-%d}\n",
      region_subtitle, section_name, i
    ))

    ### ---- PRINTED SUBTITLE ----
    cat(sprintf("\\subsection*{Regions: %s}\n\n", region_subtitle))

    ### ---- PRINT PLOT ----
    print(p)
    cat("\n")
  }
}
@

\end{document}
