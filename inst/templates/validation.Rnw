<<setup, echo=FALSE, warning=FALSE, message=FALSE>>=
format_number <- function(x) {
  ifelse(is.na(x), "", formatC(x, digits = 4, format = "g"))
}

format_period <- function(x) {
  x[is.na(x)] <- ""
  as.character(x)
}

prepare_findings <- function(x, relative_deviation = TRUE,
                             include_source = TRUE) {
  if (!nrow(x)) return(x)
  output <- data.frame(
    Check = gsub("_", "_ ", x$check_id, fixed = TRUE),
    Variable = gsub("|", "| ", x$variable, fixed = TRUE),
    Region = x$region,
    Period = format_period(x$period),
    Observed = format_number(x$observed),
    Reference = format_number(x$reference),
    Unit = x$unit,
    Deviation = if (relative_deviation) {
      ifelse(
        is.na(x$deviation), "",
        paste0(formatC(100 * x$deviation, digits = 1, format = "f"), "%")
      )
    } else {
      format_number(x$deviation)
    },
    Status = toupper(x$status),
    Message = x$message,
    Source = x$source,
    stringsAsFactors = FALSE
  )
  if (!include_source) output$Source <- NULL
  output
}

table_column_widths <- function(x) {
  if (identical(
    names(x),
    c(
      "Check", "Variable", "Region", "Period", "Observed", "Reference",
      "Unit", "Deviation", "Status", "Message", "Source"
    )
  )) {
    return(c(
      0.080, 0.130, 0.045, 0.050, 0.055, 0.055,
      0.060, 0.055, 0.045, 0.180, 0.085
    ))
  }
  if (identical(
    names(x),
    c(
      "Check", "Variable", "Region", "Period", "Observed", "Reference",
      "Unit", "Deviation", "Status", "Message"
    )
  )) {
    return(c(
      0.080, 0.155, 0.045, 0.050, 0.055,
      0.055, 0.060, 0.055, 0.045, 0.240
    ))
  }
  rep(0.84 / ncol(x), ncol(x))
}

status_badges <- c(
  PASS = "\\colorbox{statuspass}{\\strut\\textbf{Pass}}",
  WARN = "\\colorbox{statuswarn}{\\strut\\textbf{Warn}}",
  FAIL = "\\colorbox{statusfail}{\\strut\\textbf{Fail}}",
  "N/A" = "\\colorbox{statusna}{\\strut\\textbf{N/A}}",
  SKIP = "\\colorbox{statusna}{\\strut\\textbf{N/A}}"
)

prepare_status_badges <- function(x) {
  if (!"Status" %in% names(x)) return(list(data = x, replacements = character()))
  normalized <- toupper(trimws(as.character(x$Status)))
  placeholders <- sprintf(
    "POSTPROMSTATUS%08dEND", seq_along(normalized)
  )
  replacements <- unname(status_badges[normalized])
  replacements[is.na(replacements)] <- normalized[is.na(replacements)]
  names(replacements) <- placeholders
  x$Status <- placeholders
  list(data = x, replacements = replacements)
}

render_table <- function(x, longtable = TRUE, widths = NULL) {
  if (!nrow(x)) return(invisible(NULL))
  if (is.null(widths)) widths <- table_column_widths(x)
  if (length(widths) != ncol(x)) {
    stop("One LaTeX column width is required for every table column.")
  }
  alignment <- paste0(
    ">{\\raggedright\\arraybackslash}p{",
    format(widths, scientific = FALSE, trim = TRUE),
    "\\linewidth}"
  )
  font_size <- if (ncol(x) >= 9L) "tiny" else "scriptsize"
  status_data <- prepare_status_badges(x)
  latex <- knitr::kable(
    status_data$data,
    format = "latex",
    booktabs = TRUE,
    longtable = longtable,
    row.names = FALSE,
    escape = TRUE,
    align = alignment
  )
  for (placeholder in names(status_data$replacements)) {
    latex <- gsub(
      placeholder,
      status_data$replacements[[placeholder]],
      latex,
      fixed = TRUE
    )
  }
  cat(paste0("\\", font_size, "\n"))
  cat(latex, sep = "\n")
  cat("\n\\normalsize\n\n")
}

render_placeholder_or_findings <- function(x, relative_deviation = TRUE,
                                           include_source = TRUE) {
  configured <- !(nrow(x) == 1L && grepl("_not_configured$", x$check_id[1]))
  if (!configured) {
    cat(x$message[1], "\n\n")
  } else {
    render_table(prepare_findings(
      x, relative_deviation, include_source = include_source
    ))
  }
}
@

\section*{Metadata}
<<metadata, echo=FALSE, results='asis'>>=
render_table(validation_metadata, longtable = FALSE)
@

\tableofcontents
