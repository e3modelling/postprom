\documentclass{article}
\usepackage[a4paper, margin=2cm]{geometry}
\usepackage{hyperref}
\usepackage{booktabs}
\usepackage{longtable}

\title{OPEN-PROM: Validation Report}
\author{}
\date{\today}

\begin{document}
\maketitle

<<setup, echo=FALSE, warning=FALSE, message=FALSE>>=
format_number <- function(x) {
  ifelse(is.na(x), "", formatC(x, digits = 4, format = "g"))
}

format_period <- function(x) {
  x[is.na(x)] <- ""
  as.character(x)
}

prepare_findings <- function(x, relative_deviation = TRUE) {
  if (!nrow(x)) return(x)
  output <- data.frame(
    Check = x$check_id,
    Variable = x$variable,
    Region = x$region,
    Period = format_period(x$period),
    Observed = format_number(x$observed),
    Reference = format_number(x$reference),
    Unit = x$unit,
    Deviation = if (relative_deviation) {
      ifelse(
        is.na(x$deviation), "",
        paste0(formatC(100 * x$deviation, digits = 1, format = "f"), "%")
      )
    } else {
      format_number(x$deviation)
    },
    Status = toupper(x$status),
    Message = x$message,
    Source = x$source,
    stringsAsFactors = FALSE
  )
  output
}

render_table <- function(x, longtable = TRUE) {
  if (!nrow(x)) return(invisible(NULL))
  cat("\\scriptsize\n")
  cat(
    knitr::kable(
      x, format = "latex", booktabs = TRUE, longtable = longtable,
      row.names = FALSE, escape = TRUE
    ),
    sep = "\n"
  )
  cat("\n\\normalsize\n\n")
}

render_placeholder_or_findings <- function(x, relative_deviation = TRUE) {
  configured <- !(nrow(x) == 1L && grepl("_not_configured$", x$check_id[1]))
  if (!configured) {
    cat(x$message[1], "\n\n")
  } else {
    render_table(prepare_findings(x, relative_deviation))
  }
}
@

\section*{Metadata}
<<metadata, echo=FALSE, results='asis'>>=
render_table(validation_metadata, longtable = FALSE)
@

\tableofcontents
\newpage

\section{Validation overview}
The report separates four check families. A skipped check means that its
reference data, configuration, region, unit, or exact endpoint year was not
available; it is not counted as a pass.

<<overview, echo=FALSE, results='asis'>>=
render_table(validation_sections$overview, longtable = FALSE)
@

\section{Validation checks}
This section compares reported model values with historical series embedded in
the report using the \texttt{|VAL} suffix. It uses the existing OPEN-PROM
historical validation configuration and its pass/warning/failure bands.

<<historical, echo=FALSE, results='asis'>>=
validation <- validation_sections$validation
if (nrow(validation_sections$validation_summary)) {
  cat("\\subsection{Summary by variable and region}\n\n")
  render_table(validation_sections$validation_summary)
}
exceptions <- validation[validation$status != "pass", , drop = FALSE]
cat("\\subsection{Exceptions and unavailable checks}\n\n")
if (!nrow(exceptions)) {
  cat("All evaluated historical numerical checks passed.\n\n")
} else {
  render_placeholder_or_findings(exceptions)
}
@

\section{Policy checks}
The first policy-check version evaluates exact individual-country regions. A
configured target can be an absolute maximum or minimum, or a reduction or
increase relative to a specified baseline year.

<<policies, echo=FALSE, results='asis'>>=
render_placeholder_or_findings(
  validation_sections$policies,
  relative_deviation = FALSE
)
@

\section{Indicators check}
These checks use the indicators already calculated by
\texttt{reportIndicators()}. The validation layer evaluates bounds, exact-year
benchmarks, and annualized trends without recalculating indicator formulas.

<<indicators, echo=FALSE, results='asis'>>=
indicator_result <- validation_sections$indicators
cat("\\subsection{Summary}\n\n")
render_table(indicator_result$summary, longtable = FALSE)

benchmark <- indicatorFindingsForPdf(indicator_result)
benchmark <- benchmark[
  benchmark$check_id %in% indicator_result$findings$check_id[
    indicator_result$findings$check_type %in% c("level", "cagr")
  ] & benchmark$status != "skip",
  ,
  drop = FALSE
]
if (nrow(benchmark)) {
  cat("\\subsection{Evaluated benchmarks}\n\n")
  render_table(prepare_findings(benchmark))
}

indicator_exceptions <- indicatorFindingsForPdf(indicator_result)
indicator_exceptions <- indicator_exceptions[
  indicator_exceptions$status != "pass", , drop = FALSE
]
cat("\\subsection{Exceptions and unavailable checks}\n\n")
if (!nrow(indicator_exceptions)) {
  cat("All evaluated indicator checks passed.\n\n")
} else {
  render_table(prepare_findings(indicator_exceptions))
}
@

\section{Long term checks}
This section compares model CAGRs with reviewed current-policy benchmarks.
Exact start and end years are required and no interpolation is performed.

<<long_term, echo=FALSE, results='asis'>>=
render_placeholder_or_findings(validation_sections$long_term)
@

